# Database created on the Postgres container's first start (wipe the volume to change it).
POSTGRES_DB=better_drizzle

# Postgres superuser used by the healthcheck and DATABASE_URL.
POSTGRES_USER=postgres

# Local-only password for POSTGRES_USER.
POSTGRES_PASSWORD=postgres

# Host port for Postgres; change it if 5432 is taken and keep DATABASE_URL in sync.
POSTGRES_PORT=5432

# Enables the *.pg.test.ts suites and the jsonb/arrays benchmarks; they skip or refuse to run without it.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Database created on the MySQL container's first start.
MYSQL_DB=better_drizzle

# Local-only password for MySQL's root user, used by the healthcheck and MYSQL_URL.
MYSQL_ROOT_PASSWORD=mysql

# Host port for MySQL; change it if 3306 is taken and keep MYSQL_URL in sync.
MYSQL_PORT=3306

# Enables the *.mysql.test.ts suites; they skip without it.
MYSQL_URL=mysql://root:${MYSQL_ROOT_PASSWORD}@localhost:${MYSQL_PORT}/${MYSQL_DB}
